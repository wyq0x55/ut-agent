{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-agent.local/schema/test-baseline.json",
  "title": "ut-agent TestBaseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline"],
  "properties": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "approval"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "approved"},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "approved_by", "approved_at", "scope", "reason", "evidence"],
          "properties": {
            "authority": {"type": "string", "minLength": 1},
            "approved_by": {"type": "string", "minLength": 1},
            "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "scope": {"const": "baseline-and-rules"},
            "reason": {"type": "string", "minLength": 1},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "source": {"type": "object"},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "source", "meaning", "status"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "meaning": {"type": "string", "minLength": 1},
              "status": {"const": "approved"}
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "criterion": {"type": "string"},
            "branch_outcome": {"type": "boolean"},
            "source_rules": {"$ref": "#/$defs/string_array"}
          }
        },
        "condition_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logical_connectives": {"$ref": "#/$defs/string_array"},
            "condition_outcome": {"type": "boolean"},
            "source_rules": {"$ref": "#/$defs/string_array"}
          }
        },
        "boundary_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "typed": {"type": "boolean"},
            "representative_values": {
              "type": "array",
              "items": {"enum": ["min", "median", "max"]}
            },
            "adjacent_constant_values": {"type": "boolean"},
            "source_rules": {"$ref": "#/$defs/string_array"}
          }
        },
        "switch_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preserve_cases": {"type": "boolean"},
            "include_default": {"type": "boolean"},
            "source_rules": {"$ref": "#/$defs/string_array"}
          }
        },
        "loop_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "iteration_count": {"type": "boolean"},
            "boundary_state": {"type": "boolean"},
            "source_rules": {"$ref": "#/$defs/string_array"}
          }
        },
        "array_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixed_index": {"type": "boolean"},
            "preserve_other_elements": {"type": "boolean"},
            "source_rules": {"$ref": "#/$defs/string_array"}
          }
        },
        "stub_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "external_calls_are_environment": {"type": "boolean"},
            "call_count": {"type": "boolean"},
            "return_value": {"type": "boolean"},
            "arguments": {"type": "boolean"},
            "source_rules": {"$ref": "#/$defs/string_array"}
          }
        },
        "ordering_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deterministic": {"type": "boolean"},
            "case_order": {"type": "string"},
            "remaining_values": {"type": "string"},
            "source_rules": {"$ref": "#/$defs/string_array"}
          }
        }
      }
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
