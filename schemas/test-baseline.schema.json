{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-agent.local/schema/test-baseline.json",
  "title": "ut-agent TestBaseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline"],
  "properties": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "approval"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "approved"},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "approved_by", "approved_at", "scope", "reason", "evidence"],
          "properties": {
            "authority": {"type": "string", "minLength": 1},
            "approved_by": {"type": "string", "minLength": 1},
            "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "scope": {"const": "baseline-and-rules"},
            "reason": {"type": "string", "minLength": 1},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "source": {"type": "object"},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "source", "meaning", "status"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "meaning": {"type": "string", "minLength": 1},
              "status": {"const": "approved"}
            }
          }
        },
        "coverage": {"type": "object"},
        "condition_policy": {"type": "object"},
        "boundary_policy": {"type": "object"},
        "switch_policy": {"type": "object"},
        "loop_policy": {"type": "object"},
        "array_policy": {"type": "object"},
        "stub_policy": {"type": "object"},
        "ordering_policy": {"type": "object"}
      }
    }
  }
}
